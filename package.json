    "test:index": "node test/runner.js test/index.js",
    "test:interceptors": "node test/runner.js test/interceptors.js",
    "test:retry": "node test/runner.js test/retry.js",
    "test:http-handler": "node test/runner.js test/http-handler.js",
    "pretest": "npm run build",
    "test": "npm run test:index && npm run test:http-handler && npm run test:interceptors && npm run test:retry",
    "browser": "node test/runner.js test/index.js --serve"
